# Comma-separated multiaddrs of the p2p bootstrap/relay node(s). Run one with
# `npm run p2p:relay` (scripts/p2p-relay.mjs) and paste its printed addrs here.
# The relay only does signaling + circuit-relay for NAT traversal between
# browser peers — it never holds article content.
NEXT_PUBLIC_P2P_RELAY_ADDRS=

# HTTP gateway used to render cover images (an IPFS CID isn't a URL a
# browser <img> can load directly). Defaults to https://ipfs.io/ipfs if
# unset. If you change this, also add the hostname to images.remotePatterns
# in next.config.js or next/image will refuse to load it.
NEXT_PUBLIC_IPFS_GATEWAY=

# One-time secret required by POST /api/setup to create the first admin
# account. Unset by default — setup is disabled until you set this,
# otherwise the first unauthenticated caller could claim admin. Generate
# with e.g. `openssl rand -hex 32`, set it, run setup once, then you may
# unset or rotate it (the one-time lock persists in Mongo regardless).
SETUP_TOKEN=
